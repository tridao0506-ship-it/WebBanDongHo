@page
@model WebBanDongHo.Pages.Admin.CreateModel
@{
    ViewData["Title"] = "Thêm Đồng Hồ Mới";
}

<div class="container mt-4">
    <h2 class="text-center text-success mb-4 fw-bold">THÊM SẢN PHẨM MỚI</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0">

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên Đồng Hồ</label>
                    <input asp-for="DongHo.TenDongHo" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Giá Bán (VNĐ)</label>
                    <input asp-for="DongHo.GiaBan" type="number" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn Hình Ảnh</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-page="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold">Lưu Sản Phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>