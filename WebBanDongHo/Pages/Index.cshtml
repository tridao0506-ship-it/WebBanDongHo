@page
@model WebBanDongHo.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4 mb-5">
    <h2 class="text-center fw-bold mb-4">Danh Sách Đồng Hồ Nổi Bật</h2>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <form method="get" class="row g-2 shadow-sm p-3 bg-light rounded border">
                <div class="col-md-6">
                    <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control" placeholder="Nhập tên đồng hồ cần tìm..." />
                </div>
                <div class="col-md-4">
                    <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.CurrentSort))">-- Sắp xếp: Mới nhất --</option>
                        <option value="price_asc" selected="@(Model.CurrentSort == "price_asc")">Giá: Thấp đến Cao</option>
                        <option value="price_desc" selected="@(Model.CurrentSort == "price_desc")">Giá: Cao đến Thấp</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary fw-bold">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        @if (Model.DongHos != null && Model.DongHos.Any())
        {
            foreach (var item in Model.DongHos)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm text-center p-3 border position-relative">

                        @if (item.SoLuongTon <= 0)
                        {
                            <span class="badge bg-secondary position-absolute top-0 end-0 m-2 px-2 py-1">Hết hàng</span>
                        }

                        <img src="~/images/@item.HinhAnh" class="card-img-top mx-auto" style="height: 180px; object-fit: contain;" alt="@item.TenDongHo" />

                        <div class="card-body d-flex flex-column justify-content-between p-2 mt-2">
                            <div>
                                <h5 class="card-title fw-bold fs-6 mb-2">@item.TenDongHo</h5>
                                <p class="card-text text-danger fw-bold mb-1">@String.Format("{0:#,##0} đ", item.GiaBan)</p>

                                @if (item.SoLuongTon > 0)
                                {
                                    <p class="text-muted small mb-3">Kho còn: <strong>@item.SoLuongTon</strong> chiếc</p>
                                }
                                else
                                {
                                    <p class="text-danger small fw-bold mb-3">Tạm hết hàng</p>
                                }
                            </div>

                            <div class="d-flex justify-content-between gap-1 mt-auto">
                                <a href="/Details?id=@item.Id" class="btn btn-outline-secondary btn-sm w-100 fw-bold">Xem</a>

                                @if (item.SoLuongTon > 0)
                                {
                                    <a href="/Cart?handler=AddToCart&id=@item.Id" class="btn btn-outline-primary btn-sm w-100 fw-bold">Giỏ hàng</a>
                                    <a href="/Cart?handler=BuyNow&id=@item.Id" class="btn btn-primary btn-sm w-100 fw-bold">Mua ngay</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm w-100 fw-bold" disabled>Hết hàng</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted mt-4 fs-5">Không tìm thấy chiếc đồng hồ nào phù hợp.</p>
                <a href="/Index" class="btn btn-outline-primary mt-2">Xem tất cả sản phẩm</a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./Index"
                       asp-route-pageIndex="@(Model.PageIndex - 1)"
                       asp-route-searchString="@Model.CurrentFilter"
                       asp-route-sortOrder="@Model.CurrentSort">Trang trước</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-page="./Index"
                           asp-route-pageIndex="@i"
                           asp-route-searchString="@Model.CurrentFilter"
                           asp-route-sortOrder="@Model.CurrentSort">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="./Index"
                       asp-route-pageIndex="@(Model.PageIndex + 1)"
                       asp-route-searchString="@Model.CurrentFilter"
                       asp-route-sortOrder="@Model.CurrentSort">Trang sau</a>
                </li>
            </ul>
        </nav>
    }
</div>