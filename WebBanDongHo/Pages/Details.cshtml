@page "{id?}"
@model WebBanDongHo.Pages.DetailsModel
@{
    ViewData["Title"] = "Chi tiết đồng hồ";
}
<h2 class="text-center text-danger mb-4 fw-bold">CHI TIẾT SẢN PHẨM</h2>
<div class="row">
    <div class="col-md-6">
        <img src="/images/@Model.DongHo.HinhAnh"
             class="img-fluid"
             alt="@Model.DongHo.TenDongHo"
             onerror="this.onerror=null;this.src='/images/applewatch.jpg';" />
    </div>
    <div class="col-md-6">
        <h3>@Model.DongHo.TenDongHo</h3>
        <p class="fs-4 text-danger fw-bold">Giá: @Model.DongHo.GiaBan.ToString("N0") đ</p>
        <a asp-page="/Admin/Index" class="btn btn-secondary mt-3">Quay lại</a>
    </div>
</div>