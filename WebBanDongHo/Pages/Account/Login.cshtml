@page
@model WebBanDongHo.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm p-4">
            <h3 class="text-center text-primary mb-4 fw-bold">Đăng Nhập</h3>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Tài khoản</label>
                    <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập username" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mật khẩu</label>
                    <input asp-for="MatKhau" class="form-control" type="password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold mb-3">Đăng nhập</button>

                <div class="text-center">
                    <span>Chưa có tài khoản? <a href="/Account/Register" class="text-decoration-none fw-bold">Đăng ký ngay</a></span>
                </div>
            </form>
        </div>
    </div>
</div>