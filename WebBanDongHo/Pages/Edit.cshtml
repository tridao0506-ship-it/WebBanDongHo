@page
@model WebBanDongHo.Pages.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4">Chỉnh Sửa Thông Tin Đồng Hồ</h2>

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="DongHo.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đồng hồ</label>
                    <input asp-for="DongHo.TenDongHo" class="form-control" required />
                    <span asp-validation-for="DongHo.TenDongHo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                    <input asp-for="DongHo.GiaBan" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="DongHo.GiaBan" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Số lượng tồn kho</label>
                    <input asp-for="DongHo.SoLuongTon" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="DongHo.SoLuongTon" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Link hình ảnh</label>
                    <input asp-for="DongHo.HinhAnh" class="form-control" required />
                    <span asp-validation-for="DongHo.HinhAnh" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu thay đổi</button>
                    <a href="/Admin" class="btn btn-secondary fw-bold px-4">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>