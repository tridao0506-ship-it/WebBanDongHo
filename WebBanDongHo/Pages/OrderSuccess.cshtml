@page
@model WebBanDongHo.Pages.OrderSuccessModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container text-center mt-5 mb-5">
    <div class="card shadow-sm p-5 mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <span class="text-success" style="font-size: 80px;">✔</span>
        </div>
        <h2 class="text-success fw-bold mb-3">Đặt Hàng Thành Công!</h2>
        <p class="text-muted mb-4 fs-5">Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.</p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/Orders" class="btn btn-outline-primary px-4 fw-bold">Xem lịch sử đơn hàng</a>
            <a href="/Index" class="btn btn-success px-4 fw-bold">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>