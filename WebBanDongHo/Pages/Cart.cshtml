@page
@model WebBanDongHo.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 fw-bold">Giỏ Hàng Của Bạn</h2>

    @if (Model.Cart != null && Model.Cart.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle shadow-sm bg-white rounded">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th class="text-center">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Cart)
                    {
                        <tr>
                            <td>
                                <img src="~/images/@item.HinhAnh" style="width: 50px; height: 50px; object-fit: contain;" class="me-2" />
                                <strong>@item.TenDongHo</strong>
                            </td>
                            <td>@String.Format("{0:#,##0} đ", item.GiaBan)</td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center">
                                    <a asp-page-handler="Decrease" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm px-2 py-0 fw-bold">-</a>
                                    <span class="mx-3 fw-bold">@item.SoLuong</span>
                                    <a asp-page-handler="Increase" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm px-2 py-0 fw-bold">+</a>
                                </div>
                            </td>
                            <td class="fw-bold text-danger">@String.Format("{0:#,##0} đ", item.GiaBan * item.SoLuong)</td>
                            <td>
                                <a asp-page-handler="Remove" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4 class="fw-bold">Tổng cộng: <span class="text-danger">@String.Format("{0:#,##0} đ", Model.TongTien)</span></h4>
            @if (User?.Identity != null && User.Identity.IsAuthenticated)
            {
                <a href="/Checkout" class="btn btn-success btn-lg">Tiến hành thanh toán</a>
            }
            else
            {
                <a href="/Account/Login?returnUrl=%2FCheckout" class="btn btn-success btn-lg">Tiến hành thanh toán</a>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Giỏ hàng của bạn đang trống.</p>
            <a href="/Index" class="btn btn-primary">Tiếp tục mua sắm</a>
        </div>
    }
</div>