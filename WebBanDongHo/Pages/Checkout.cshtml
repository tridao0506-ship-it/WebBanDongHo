@page
@model WebBanDongHo.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-4 mb-5">
    <h2 class="text-center fw-bold mb-4">Thông Tin Đặt Hàng</h2>

    <form method="post">
        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm p-4">
                    <h4 class="mb-3">Thông tin người nhận</h4>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input type="text" asp-for="HoTen" class="form-control" required placeholder="Nhập họ và tên của bạn" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="text" asp-for="SoDienThoai" id="phone_input" class="form-control"
                               required
                               pattern="^0\d{9}$"
                               title="Số điện thoại phải bắt đầu bằng số 0 và có chính xác 10 chữ số"
                               placeholder="Số điện thoại" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Tỉnh / Thành phố</label>
                            <select id="province_select" class="form-select">
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Quận / Huyện</label>
                            <select id="district_select" class="form-select" disabled>
                                <option value="">-- Chọn Quận/Huyện --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Phường / Xã</label>
                            <select id="ward_select" class="form-select" disabled>
                                <option value="">-- Chọn Phường/Xã --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                        <textarea asp-for="DiaChi" id="address_input" class="form-control" rows="3" required placeholder="Nhập địa chỉ nhận hàng chi tiết"></textarea>
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

s                    <div class="mb-3">
                        <label class="form-label fw-bold">Phương thức thanh toán</label>
                        <div class="form-check p-3 border rounded mb-2">
                            <input class="form-check-input ms-1" type="radio" asp-for="PhuongThucThanhToan" id="pay_cod" value="COD" checked>
                            <label class="form-check-label ms-2 fw-bold" for="pay_cod">
                                Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>
                        <div class="form-check p-3 border rounded">
                            <input class="form-check-input ms-1" type="radio" asp-for="PhuongThucThanhToan" id="pay_qr" value="VietQR">
                            <label class="form-check-label ms-2 fw-bold text-primary" for="pay_qr">
                                Chuyển khoản ngân hàng (Quét mã VietQR)
                            </label>
                        </div>
                    </div>

                    <div id="vietqr_box" class="card border-primary p-3 mb-3 text-center d-none">
                        <h6 class="fw-bold text-primary mb-2">Quét mã VietQR bằng App Ngân hàng / MoMo</h6>
                        <div class="d-flex justify-content-center my-2">
                            <img id="vietqr_img" src="" alt="Mã VietQR thanh toán" class="img-fluid rounded border" style="max-width: 260px;" />
                        </div>
                        <div class="small mt-2">
                            <div>Số tiền: <strong id="qr_amount_text" class="text-danger">0 đ</strong></div>
                            <div>Nội dung CK: <strong id="qr_content_text" class="text-primary">DH WEBBANDONGHO</strong></div>
                            <div class="text-muted mt-1">Sau khi chuyển khoản xong, vui lòng bấm <strong>Xác nhận đặt hàng</strong>.</div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="PhiShip" id="phi_ship_input" />

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold fs-5">Xác nhận đặt hàng</button>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm p-4">
                    <h4 class="mb-3">Tóm tắt đơn hàng</h4>

                    @if (Model.Cart != null && Model.Cart.Any())
                    {
                        @foreach (var item in Model.Cart)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <div>
                                    <h6 class="fw-bold mb-0">@item.TenDongHo</h6>
                                    <small class="text-muted">Số lượng: @item.SoLuong</small>
                                </div>
                                <span class="fw-bold text-danger">@String.Format("{0:#,##0} đ", item.GiaBan * item.SoLuong)</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Tiền hàng:</span>
                            <span class="fw-bold">@String.Format("{0:#,##0} đ", Model.TienHang)</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <span>Phí vận chuyển (GHN):</span>
                            <span id="shipping_fee_text" class="fw-bold text-primary">@String.Format("{0:#,##0} đ", Model.PhiShip)</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <h5 class="fw-bold">Tổng cộng:</h5>
                            <h4 id="final_total_text" class="fw-bold text-danger">@String.Format("{0:#,##0} đ", Model.TongTien)</h4>
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const pSel = document.getElementById("province_select");
        const dSel = document.getElementById("district_select");
        const wSel = document.getElementById("ward_select");
        const addrInput = document.getElementById("address_input");
        const phoneInput = document.getElementById("phone_input");
        const feeText = document.getElementById("shipping_fee_text");
        const feeInput = document.getElementById("phi_ship_input");
        const totalText = document.getElementById("final_total_text");
        const tienHang = @((long)Model.TienHang);

        const BANK_ID = "MB";              
        const ACCOUNT_NO = "4300105062005";    
        const ACCOUNT_NAME = "DAO SY TRI";  

        const payCod = document.getElementById("pay_cod");
        const payQr = document.getElementById("pay_qr");
        const qrBox = document.getElementById("vietqr_box");
        const qrImg = document.getElementById("vietqr_img");
        const qrAmountText = document.getElementById("qr_amount_text");
        const qrContentText = document.getElementById("qr_content_text");

        let currentFee = 0;
        const randomOrderCode = "DH" + Math.floor(100000 + Math.random() * 900000);

        function formatVnd(amount) {
            return new Intl.NumberFormat("vi-VN").format(amount) + " đ";
        }

        function updateVietQR() {
            if (!payQr || !payQr.checked) {
                if (qrBox) qrBox.classList.add("d-none");
                return;
            }

            const totalAmount = tienHang + currentFee;
            const phone = phoneInput ? phoneInput.value.trim() : "";
            const addInfo = phone ? `${randomOrderCode} ${phone}` : randomOrderCode;

            const qrUrl = `https://img.vietqr.io/image/${BANK_ID}-${ACCOUNT_NO}-compact2.png?amount=${totalAmount}&addInfo=${encodeURIComponent(addInfo)}&accountName=${encodeURIComponent(ACCOUNT_NAME)}`;

            if (qrImg) qrImg.src = qrUrl;
            if (qrAmountText) qrAmountText.innerText = formatVnd(totalAmount);
            if (qrContentText) qrContentText.innerText = addInfo;
            if (qrBox) qrBox.classList.remove("d-none");
        }

        if (payCod) payCod.addEventListener("change", updateVietQR);
        if (payQr) payQr.addEventListener("change", updateVietQR);
        if (phoneInput) phoneInput.addEventListener("input", updateVietQR);

        const allProvinces = [
            "Hà Nội", "TP. Hồ Chí Minh", "Đà Nẵng", "Hải Phòng", "Cần Thơ",
            "An Giang", "Bà Rịa - Vũng Tàu", "Bắc Giang", "Bắc Kạn", "Bạc Liêu",
            "Bắc Ninh", "Bến Tre", "Bình Định", "Bình Dương", "Bình Phước",
            "Bình Thuận", "Cà Mau", "Cao Bằng", "Đắk Lắk", "Đắk Nông",
            "Điện Biên", "Đồng Nai", "Đồng Tháp", "Gia Lai", "Hà Giang",
            "Hà Nam", "Hà Tĩnh", "Hải Dương", "Hậu Giang", "Hòa Bình",
            "Hưng Yên", "Khánh Hòa", "Kiên Giang", "Kon Tum", "Lai Châu",
            "Lâm Đồng", "Lạng Sơn", "Lào Cai", "Long An", "Nam Định",
            "Nghệ An", "Ninh Bình", "Ninh Thuận", "Phú Thọ", "Phú Yên",
            "Quảng Bình", "Quảng Nam", "Quảng Ngãi", "Quảng Ninh", "Quảng Trị",
            "Sóc Trăng", "Sơn La", "Tây Ninh", "Thái Bình", "Thái Nguyên",
            "Thanh Hóa", "Thừa Thiên Huế", "Tiền Giang", "Trà Vinh", "Tuyên Quang",
            "Vĩnh Long", "Vĩnh Phúc", "Yên Bái"
        ];

        let isGhnReady = false;

        function updateFee(fee) {
            currentFee = parseInt(fee, 10) || 0;
            feeText.innerText = formatVnd(currentFee);
            if (feeInput) feeInput.value = currentFee;
            if (totalText) totalText.innerText = formatVnd(tienHang + currentFee);
            updateVietQR();
        }

        function estimateFee(provinceName) {
            const p = (provinceName || "").toLowerCase();
            if (p.includes("hà nội")) return 20000;
            if (p.includes("hồ chí minh") || p.includes("cần thơ") || p.includes("bình dương") || p.includes("đồng nai") || p.includes("bà rịa")) return 35000;
            if (p.includes("đà nẵng") || p.includes("thừa thiên huế") || p.includes("khánh hòa") || p.includes("nghệ an")) return 30000;
            return 28000;
        }

        function load63Provinces() {
            isGhnReady = false;
            pSel.innerHTML = '<option value="">-- Chọn Tỉnh/Thành --</option>' +
                allProvinces.map(p => `<option value="${p}">${p}</option>`).join("");
        }

        fetch("?handler=GhnProvinces")
            .then(r => r.json())
            .then(res => {
                if (res && res.code === 200 && Array.isArray(res.data) && res.data.length > 0) {
                    isGhnReady = true;
                    pSel.innerHTML = '<option value="">-- Chọn Tỉnh/Thành --</option>' +
                        res.data.map(p => `<option value="${p.ProvinceID}">${p.ProvinceName}</option>`).join("");
                } else {
                    load63Provinces();
                }
            })
            .catch(() => load63Provinces());

        pSel.addEventListener("change", function () {
            dSel.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            dSel.disabled = true;
            wSel.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wSel.disabled = true;
            updateFee(0);
            if (!this.value) return;

            if (!isGhnReady) {
                const dists = [`TP / Thị xã ${this.value}`, "Quận / Huyện trung tâm", "Quận / Huyện lân cận"];
                dSel.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>' +
                    dists.map(d => `<option value="${d}">${d}</option>`).join("");
                dSel.disabled = false;
                return;
            }

            dSel.innerHTML = '<option value="">-- Đang tải... --</option>';
            fetch(`?handler=GhnDistricts&provinceId=${this.value}`)
                .then(r => r.json())
                .then(res => {
                    if (res && res.code === 200 && Array.isArray(res.data)) {
                        dSel.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>' +
                            res.data.map(d => `<option value="${d.DistrictID}">${d.DistrictName}</option>`).join("");
                        dSel.disabled = false;
                    }
                });
        });

        dSel.addEventListener("change", function () {
            wSel.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wSel.disabled = true;
            updateFee(0);
            if (!this.value) return;

            if (!isGhnReady) {
                const wards = ["Phường / Thị trấn trung tâm", "Phường / Xã 1", "Phường / Xã 2"];
                wSel.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>' +
                    wards.map(w => `<option value="${w}">${w}</option>`).join("");
                wSel.disabled = false;
                return;
            }

            wSel.innerHTML = '<option value="">-- Đang tải... --</option>';
            fetch(`?handler=GhnWards&districtId=${this.value}`)
                .then(r => r.json())
                .then(res => {
                    if (res && res.code === 200 && Array.isArray(res.data)) {
                        wSel.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>' +
                            res.data.map(w => `<option value="${w.WardCode}">${w.WardName}</option>`).join("");
                        wSel.disabled = false;
                    }
                });
        });

        wSel.addEventListener("change", function () {
            if (!this.value || !dSel.value) return;

            const pText = pSel.selectedIndex > 0 ? pSel.options[pSel.selectedIndex].text : "";
            const dText = dSel.selectedIndex > 0 ? dSel.options[dSel.selectedIndex].text : "";
            const wText = wSel.selectedIndex > 0 ? wSel.options[wSel.selectedIndex].text : "";
            const areaText = [wText, dText, pText].filter(Boolean).join(", ");

            if (addrInput && areaText && addrInput.value.trim() === "") {
                addrInput.value = areaText;
            }

            const fallbackFee = estimateFee(pText);
            if (!isGhnReady) {
                updateFee(fallbackFee);
                return;
            }

            feeText.innerText = "Đang tính...";
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = { "Content-Type": "application/json" };
            if (tokenEl) headers["RequestVerificationToken"] = tokenEl.value;

            fetch("?handler=CalculateFee", {
                method: "POST",
                headers,
                body: JSON.stringify({
                    toDistrictId: parseInt(dSel.value, 10),
                    toWardCode: this.value
                })
            })
            .then(r => r.json())
            .then(res => {
                const apiFee = parseInt(res.fee, 10) || 0;
                updateFee(apiFee > 0 ? apiFee : fallbackFee);
            })
            .catch(() => updateFee(fallbackFee));
        });
    });
</script>